{
  "name": "krishi-sahayak",
  "version": "1.0.0",
  "private": true,
  "description": "Krishi Sahayak field-support Android app",
  "scripts": {
    "server": "node server/server.js",
    "sync": "cap sync android",
    "open": "cap open android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:prepare": "cap add android || true",
    "android:permissions": "node scripts/prepare-android.js",
    "android:build": "npm run android:permissions && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
